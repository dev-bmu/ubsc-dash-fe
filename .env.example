# ===== Backend =====
# Tujuan rewrite /api/* dan /uploads/* di next.config.ts (ubsc-api).
API_BASE_URL=http://localhost:4020

# ===== Aplikasi =====
# URL publik panel admin; dipakai untuk menyusun URL absolut.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# R13: semua proses memakai zona waktu yang sama. UTC di database dan di kabel,
# Asia/Jakarta hanya saat render.
TZ=Asia/Jakarta

# ===== Sinkronisasi kontrak =====
# Path lokal ke repo ubsc-api, dibaca npm run sync:contracts.
UBSC_API_LOCAL_PATH=../ubsc-api
